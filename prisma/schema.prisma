generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  isAdmin      Boolean   @default(false)
  isBlocked    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  // Bumped on every password reset so old session cookies stop working
  // immediately instead of staying valid until they naturally expire.
  tokenVersion Int       @default(0)

  notifyPicksDue Boolean @default(true)
  notifyScoring  Boolean @default(true)
  notifyInvites  Boolean @default(true)

  leagues     League[]
  memberships LeagueMember[]
  resetTokens PasswordResetToken[]
}

model LeagueTemplate {
  id             String   @id @default(cuid())
  name           String
  subject        String
  glyph          String   @default("🎬")
  weeks          Int      @default(8)
  scoringPerWeek Int      @default(1)
  dueDay         String   @default("SUNDAY")
  draftMode      String   @default("SNAKE")
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  contestants           String[] @default([])
  eliminatedContestants String[] @default([])
  tag                   String?
  // WEEKLY_TOP3 (DWTS) answer key, filled in by admin once the real
  // results are known. Each locks after its first save — see
  // /api/admin/templates/[id]/actual-results.
  actualFinalFour       String[] @default([])
  actualWinner          String?
  // Assumed Pacific time — matches the picks-due reminder's fixed-timezone
  // approach until leagues store their own timezone.
  draftOpenDay          String?
  draftOpenTime         String?
  // "ROSTER" — draft a set of contestants once, score on their individual
  // performance. "WEEKLY_TOP3" — pick a season winner once, then predict a
  // ranked top three (+ optional song) every week (DWTS). "WEEKLY_CATEGORIES"
  // — no drafting, predict Star Baker/Technical winner/Voted off from the
  // whole cast every week (Bake Off).
  pickFormat            String   @default("ROSTER")
  // Week number -> theme name (e.g. {"1": "Cake Week"}), filled in as
  // they're announced. A week with no entry just shows as "Week N".
  weekThemes            Json     @default("{}")

  rules          LeagueTemplateRule[]
  leagues        League[]
  notifySignups  NotifySignup[]
  ruleAwards     LeagueTemplateRuleAward[]
  weeklyScores   LeagueTemplateWeeklyScore[]
  weeklyResults  LeagueTemplateWeeklyResult[]
}

model NotifySignup {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  template   LeagueTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  @@unique([email, templateId])
  @@index([templateId])
}

model LeagueTemplateRule {
  id     String @id @default(cuid())
  label  String
  points Int
  order  Int    @default(0)

  template   LeagueTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  awards     LeagueTemplateRuleAward[]

  @@index([templateId])
}

// Admin-entered weekly scoring: which contestant(s) earned a given
// template rule in a given week. Applies to every league built off that
// template (matched by tag) since scoring lives at the template level,
// not per league.
model LeagueTemplateRuleAward {
  id         String   @id @default(cuid())
  week       Int
  contestant String
  createdAt  DateTime @default(now())

  rule   LeagueTemplateRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId String

  template   LeagueTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  @@unique([ruleId, week, contestant])
  @@index([templateId, week])
}

// WEEKLY_TOP3 templates (DWTS): the raw score you give each couple for a
// week. The top three (ties included) are computed from these at read
// time rather than stored — nobody has to separately toggle "correct
// couple" / "exact order" once the scores are in.
model LeagueTemplateWeeklyScore {
  id         String @id @default(cuid())
  week       Int
  contestant String
  score      Int    @default(0)

  template   LeagueTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  @@unique([templateId, week, contestant])
  @@index([templateId, week])
}

// WEEKLY_CATEGORIES templates (Bake Off): the admin-entered answer key for
// one week — who actually won Star Baker/the technical, who was actually
// voted off, who came last in the technical, and who got a Hollywood
// handshake (stored as a name -> count map since a baker can get more than
// one in an episode). Applies to every league built off this template.
model LeagueTemplateWeeklyResult {
  id                    String  @id @default(cuid())
  week                  Int
  actualStarBaker       String?
  actualTechnicalWinner String?
  actualVotedOff        String?
  actualTechnicalLoser  String?
  handshakes            Json    @default("{}")

  template   LeagueTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  @@unique([templateId, week])
  @@index([templateId, week])
}

model League {
  id          String    @id @default(cuid())
  name        String
  glyph       String    @default("🎬")
  description String?
  isActive    Boolean   @default(true)
  visibility  String    @default("PRIVATE")
  inviteCode  String    @unique
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  tag         String?

  weeks          Int?
  startDate      DateTime?
  scoringPerWeek Int?
  dueDay         String
  dueTime        String
  // IANA zone the commissioner picked for dueTime — lets members see PT/MT/CT/ET
  // instead of guessing which zone a bare time means.
  timezone       String   @default("America/Los_Angeles")
  lastPicksReminderSentAt DateTime?

  draftMode            String
  draftModeDescription String?

  entryFeeEnabled    Boolean @default(false)
  entryFeeAmount     Int?
  entryFeePayMethod  String?
  entryFeeHandle     String?

  prizeEnabled Boolean @default(false)
  prizePlaces  Int?
  prizeRules   Json?

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  template   LeagueTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?

  rules   LeagueRule[]
  members LeagueMember[]
  picks   LeagueMemberPick[]

  @@index([ownerId])
  @@index([templateId])
}

model LeagueRule {
  id       String  @id @default(cuid())
  label    String
  points   Int
  order    Int     @default(0)
  isCustom Boolean @default(false)

  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId String

  @@index([leagueId])
}

model LeagueMember {
  id             String   @id @default(cuid())
  role           String   @default("MEMBER")
  joinedAt       DateTime @default(now())
  // Off by default for new memberships (league creation, join) — existing
  // members keep whatever they already had, since a schema default only
  // applies to rows created after this changed.
  notifyPicksDue Boolean  @default(false)
  // WEEKLY_TOP3 leagues (DWTS): the season-winner pick, made once and then
  // locked — the API refuses to change it once set.
  winnerPick     String?
  // Pre-season prediction of the final four, made once and then locked —
  // same rule as winnerPick. +5 points per correct name once scored.
  finalFourPicks String[] @default([])

  league      League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId    String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  picks         LeagueMemberPick[]
  weeklyPicks   LeagueMemberWeeklyPick[]
  categoryPicks LeagueMemberCategoryPick[]

  @@unique([leagueId, userId])
  @@index([leagueId])
  @@index([userId])
}

// Which contestant a member drafted, within one league. First-come,
// first-served — a contestant can only be held by one member per league
// (matches FREE_FOR_ALL, the only drafting mode the real templates use).
// This is an early, unrestricted-window MVP: no pick limit per member yet,
// and template.draftOpenDay/Time is shown to members as information only,
// not enforced as a hard gate.
model LeagueMemberPick {
  id         String   @id @default(cuid())
  contestant String
  pickedAt   DateTime @default(now())

  member   LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId String

  @@unique([leagueId, contestant])
  @@index([leagueId])
  @@index([memberId])
}

// WEEKLY_TOP3 leagues (DWTS): one member's ranked top-three prediction for
// one week, plus an optional song prediction. topThree is stored in rank
// order (index 0 = 1st place pick).
model LeagueMemberWeeklyPick {
  id             String   @id @default(cuid())
  week           Int
  topThree       String[] @default([])
  songPrediction String?
  // Set by the league's commissioner, not the member — song predictions
  // aren't judged against a stored "actual" answer like the top three are,
  // so this is the commissioner's own call, toggled from the Submissions
  // tab and scored automatically once set.
  songCorrect    Boolean  @default(false)
  submittedAt    DateTime @default(now())

  member   LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  @@unique([memberId, week])
  @@index([memberId])
}

// WEEKLY_CATEGORIES leagues (Bake Off): one member's three weekly
// predictions — who wins Star Baker, who wins the technical, and who gets
// voted off. Editable until the league's due time, same as other weekly
// picks; week 1 is collected but never scored (nothing's happened yet).
model LeagueMemberCategoryPick {
  id            String   @id @default(cuid())
  week          Int
  starBakerPick String?
  technicalPick String?
  votedOffPick  String?
  submittedAt   DateTime @default(now())

  member   LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  @@unique([memberId, week])
  @@index([memberId])
}

// One row per page load, written by /api/track (never for admin users —
// filtered out at write time, not read time, so admin browsing never
// pollutes the traffic numbers). visitorId is an anonymous cookie set by
// middleware, independent of login — lets us count real visitors,
// logged in or not. Sessions/duration are derived at query time by
// grouping a visitor's rows with gaps under 30 minutes, not stored.
model PageView {
  id        String   @id @default(cuid())
  path      String
  visitorId String
  userId    String?
  createdAt DateTime @default(now())

  @@index([visitorId, createdAt])
  @@index([path])
  @@index([createdAt])
}

// A global "never email this address" list, managed from the admin
// panel — separate from User.notifyPicksDue/etc (which are per-account
// preferences a logged-in user sets for themselves). This covers anyone,
// account or not, and every send in lib/email.ts checks it except
// password resets (a user actively requesting one still needs it) and
// admin test sends.
model SuppressedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}
