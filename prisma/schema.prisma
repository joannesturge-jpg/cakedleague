generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  isAdmin      Boolean   @default(false)
  isBlocked    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  notifyPicksDue Boolean @default(true)
  notifyScoring  Boolean @default(true)
  notifyInvites  Boolean @default(true)

  leagues     League[]
  memberships LeagueMember[]
  resetTokens PasswordResetToken[]
}

model LeagueTemplate {
  id             String   @id @default(cuid())
  name           String
  subject        String
  glyph          String   @default("🎬")
  weeks          Int      @default(8)
  scoringPerWeek Int      @default(1)
  dueDay         String   @default("SUNDAY")
  draftMode      String   @default("SNAKE")
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  contestants           String[] @default([])
  eliminatedContestants String[] @default([])
  tag                   String?
  // Assumed Pacific time — matches the picks-due reminder's fixed-timezone
  // approach until leagues store their own timezone.
  draftOpenDay          String?
  draftOpenTime         String?
  // "ROSTER" — draft a set of contestants once, score on their individual
  // performance (Bake Off). "WEEKLY_TOP3" — pick a season winner once, then
  // predict a ranked top three (+ optional song) every week (DWTS).
  pickFormat            String   @default("ROSTER")

  rules          LeagueTemplateRule[]
  leagues        League[]
  notifySignups  NotifySignup[]
  ruleAwards     LeagueTemplateRuleAward[]
  weeklyScores   LeagueTemplateWeeklyScore[]
}

model NotifySignup {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  template   LeagueTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  @@unique([email, templateId])
  @@index([templateId])
}

model LeagueTemplateRule {
  id     String @id @default(cuid())
  label  String
  points Int
  order  Int    @default(0)

  template   LeagueTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  awards     LeagueTemplateRuleAward[]

  @@index([templateId])
}

// Admin-entered weekly scoring: which contestant(s) earned a given
// template rule in a given week. Applies to every league built off that
// template (matched by tag) since scoring lives at the template level,
// not per league.
model LeagueTemplateRuleAward {
  id         String   @id @default(cuid())
  week       Int
  contestant String
  createdAt  DateTime @default(now())

  rule   LeagueTemplateRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId String

  template   LeagueTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  @@unique([ruleId, week, contestant])
  @@index([templateId, week])
}

// WEEKLY_TOP3 templates (DWTS): the raw score you give each couple for a
// week. The top three (ties included) are computed from these at read
// time rather than stored — nobody has to separately toggle "correct
// couple" / "exact order" once the scores are in.
model LeagueTemplateWeeklyScore {
  id         String @id @default(cuid())
  week       Int
  contestant String
  score      Int    @default(0)

  template   LeagueTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  @@unique([templateId, week, contestant])
  @@index([templateId, week])
}

model League {
  id          String    @id @default(cuid())
  name        String
  glyph       String    @default("🎬")
  description String?
  isActive    Boolean   @default(true)
  visibility  String    @default("PRIVATE")
  inviteCode  String    @unique
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  tag         String?

  weeks          Int?
  startDate      DateTime?
  scoringPerWeek Int?
  dueDay         String
  dueTime        String
  lastPicksReminderSentAt DateTime?

  draftMode            String
  draftModeDescription String?

  entryFeeEnabled    Boolean @default(false)
  entryFeeAmount     Int?
  entryFeePayMethod  String?
  entryFeeHandle     String?

  prizeEnabled Boolean @default(false)
  prizePlaces  Int?
  prizeRules   Json?

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  template   LeagueTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?

  rules   LeagueRule[]
  members LeagueMember[]
  picks   LeagueMemberPick[]

  @@index([ownerId])
  @@index([templateId])
}

model LeagueRule {
  id       String  @id @default(cuid())
  label    String
  points   Int
  order    Int     @default(0)
  isCustom Boolean @default(false)

  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId String

  @@index([leagueId])
}

model LeagueMember {
  id             String   @id @default(cuid())
  role           String   @default("MEMBER")
  joinedAt       DateTime @default(now())
  notifyPicksDue Boolean  @default(true)
  // WEEKLY_TOP3 leagues (DWTS): the season-winner pick, made once and then
  // locked — the API refuses to change it once set.
  winnerPick     String?

  league      League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId    String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  picks       LeagueMemberPick[]
  weeklyPicks LeagueMemberWeeklyPick[]

  @@unique([leagueId, userId])
  @@index([leagueId])
  @@index([userId])
}

// Which contestant a member drafted, within one league. First-come,
// first-served — a contestant can only be held by one member per league
// (matches FREE_FOR_ALL, the only drafting mode the real templates use).
// This is an early, unrestricted-window MVP: no pick limit per member yet,
// and template.draftOpenDay/Time is shown to members as information only,
// not enforced as a hard gate.
model LeagueMemberPick {
  id         String   @id @default(cuid())
  contestant String
  pickedAt   DateTime @default(now())

  member   LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId String

  @@unique([leagueId, contestant])
  @@index([leagueId])
  @@index([memberId])
}

// WEEKLY_TOP3 leagues (DWTS): one member's ranked top-three prediction for
// one week, plus an optional song prediction. topThree is stored in rank
// order (index 0 = 1st place pick).
model LeagueMemberWeeklyPick {
  id             String   @id @default(cuid())
  week           Int
  topThree       String[] @default([])
  songPrediction String?
  submittedAt    DateTime @default(now())

  member   LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  @@unique([memberId, week])
  @@index([memberId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}
