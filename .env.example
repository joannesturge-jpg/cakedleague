# Supabase connection pooler strings — NOT the "Direct connection" string,
# which is IPv6-only and unreachable from Vercel. Get both from Supabase's
# Connect dialog: DATABASE_URL = "Transaction pooler" (port 6543), DIRECT_URL
# = "Session pooler" (port 5432). Same host, different port/mode.
DATABASE_URL=
DIRECT_URL=

# Random secret used to sign session cookies. Generate with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated list of emails that get admin access automatically on signup/login.
# Set this to your own email before you sign up.
ADMIN_EMAILS=

# Public URL of the site, used to build links in emails (no trailing slash).
APP_URL=http://localhost:3000

# Resend API key for sending password-reset and feedback emails. Leave
# blank in dev — both get logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Caked Leagues <onboarding@resend.dev>"

# Where "Share feedback" submissions get emailed.
FEEDBACK_EMAIL=

# Cookie domain so the login session is shared between cakedleagues.com and
# admin.cakedleagues.com. Leave blank for local dev.
COOKIE_DOMAIN=
